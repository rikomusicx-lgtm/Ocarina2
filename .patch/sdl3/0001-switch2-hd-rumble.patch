+    const Uint16 *values = (const Uint16 *)data;
+
+    if (device->product_id == USB_PRODUCT_NINTENDO_SWITCH2_GAMECUBE_CONTROLLER ||
+        size != (int)sizeof(ctx->rumble_hd_data)) {
+        return SDL_Unsupported();
+    }
+
+    SDL_memcpy(ctx->rumble_hd_data, values, sizeof(ctx->rumble_hd_data));
+    ctx->rumble_hd = (values[1] || values[3] || values[5] || values[7]);
