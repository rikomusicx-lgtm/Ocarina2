/* Ocarina2: near-black OLED background, one Switch-style violet accent (#9a7cf5),
   soft rounded controls (12-14px), generous spacing and a Spotify-ish title weight. */

QToolTip {
    background: #221d33;
    color: #ececf1;
    border: 1px solid #332e4d;
    border-radius: 8px;
    padding: 7px 10px;
}

QMenuBar { background: #0d0b16; }
QMenuBar::item { padding: 7px 12px; background: transparent; border-radius: 8px; }
QMenuBar::item:selected { background: #221d33; }

QMenu {
    background: #1d1930;
    border: 1px solid #332e4d;
    border-radius: 14px;
    padding: 7px;
}
QMenu::item { padding: 8px 32px 8px 16px; border-radius: 8px; }
QMenu::item:selected { background: #322a52; color: #ececf1; }
QMenu::item:disabled { color: #55555f; }
QMenu::separator { height: 1px; background: #332e4d; margin: 6px 10px; }
QMenu::indicator { width: 15px; height: 15px; left: 7px; }

QPushButton {
    background: #221d33;
    border: 1px solid #332e4d;
    border-radius: 12px;
    padding: 9px 20px;
}
QPushButton:hover { background: #2a2540; border-color: #4b4269; }
QPushButton:pressed { background: #322a52; }
QPushButton:default { background: #9a7cf5; color: #1c1433; border: 1px solid #9a7cf5; }
QPushButton:default:hover { background: #b49cf8; }
QPushButton:disabled { color: #55555f; background: #181622; }

QLineEdit, QComboBox, QPlainTextEdit, QTextEdit {
    background: #1a162a;
    border: 1px solid #332e4d;
    border-radius: 12px;
    padding: 8px 12px;
}
QLineEdit:focus, QComboBox:focus, QPlainTextEdit:focus, QTextEdit:focus { border-color: #a78bfa; }
QComboBox:hover, QLineEdit:hover { border-color: #3a3a42; }
QComboBox::drop-down { border: none; width: 26px; }
QComboBox QAbstractItemView {
    background: #1b1b1f;
    border: 1px solid #2a2a30;
    padding: 4px;
    outline: none;
    selection-background-color: #2b2640;
    selection-color: #ececf1;
}

QCheckBox, QRadioButton { spacing: 10px; }
QCheckBox::indicator {
    width: 17px;
    height: 17px;
    border-radius: 6px;
    border: 1px solid #4b4269;
    background: #1a162a;
}
QCheckBox::indicator:hover { border-color: #9a7cf5; }
QCheckBox::indicator:checked {
    background: #9a7cf5;
    border-color: #9a7cf5;
}
QCheckBox::indicator:disabled { background: #141324; border-color: #221d33; }

QGroupBox {
    border: 1px solid #2d2745;
    border-radius: 16px;
    margin-top: 26px;
    padding: 16px 14px 12px 14px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 6px;
    color: #9a9aa8;
}

QTabWidget::pane { border: none; }
QTabBar::tab {
    background: transparent;
    color: #9a9aa8;
    padding: 8px 14px;
    border: none;
    border-bottom: 2px solid transparent;
}
QTabBar::tab:hover { color: #ececf1; }
QTabBar::tab:selected { color: #ececf1; border-bottom: 2px solid #9a7cf5; }

QScrollBar:vertical { background: transparent; width: 12px; margin: 0; }
QScrollBar:horizontal { background: transparent; height: 12px; margin: 0; }
QScrollBar::handle:vertical { background: #3a3452; border-radius: 6px; min-height: 36px; margin: 2px; }
QScrollBar::handle:horizontal { background: #3a3452; border-radius: 6px; min-width: 36px; margin: 2px; }
QScrollBar::handle:hover { background: #554e78; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

QHeaderView::section {
    background: #111113;
    color: #9a9aa8;
    border: none;
    border-bottom: 1px solid #222227;
    padding: 6px 10px;
}
QTreeView, QListView, QTableView { border: none; outline: none; }
QTreeView::item, QListView::item { padding: 4px; }
QTreeView::item:selected, QListView::item:selected, QTableView::item:selected {
    background: #2b2640;
    color: #ececf1;
}

QSlider::groove:horizontal { height: 4px; background: #2a2a30; border-radius: 2px; }
QSlider::sub-page:horizontal { background: #9a7cf5; border-radius: 2px; }
QSlider::handle:horizontal {
    background: #ececf1;
    width: 15px;
    height: 15px;
    margin: -6px 0;
    border-radius: 8px;
}

QProgressBar {
    background: #1a162a;
    border: none;
    border-radius: 6px;
    text-align: center;
    color: #ececf1;
}
QProgressBar::chunk { background: #9a7cf5; border-radius: 6px; }

QStatusBar { background: #0d0b16; color: #9a93b8; }
QStatusBar::item { border: none; }
QStatusBar QLabel { color: #9a93b8; padding: 0 6px; }
QPushButton#TogglableStatusBarButton, QPushButton#DockingStatusBarButton,
QPushButton#OotFpsStatusBarButton, QPushButton#GPUStatusBarButton,
QPushButton#RendererStatusBarButton, QPushButton#RefreshButton {
    background: transparent;
    border: none;
    color: #9a93b8;
    padding: 4px 12px;
    border-radius: 8px;
}
QPushButton#TogglableStatusBarButton:hover, QPushButton#DockingStatusBarButton:hover,
QPushButton#OotFpsStatusBarButton:hover, QPushButton#GPUStatusBarButton:hover,
QPushButton#RendererStatusBarButton:hover, QPushButton#RefreshButton:hover {
    background: #221d33;
    color: #ececf1;
}
QPushButton#OotFpsStatusBarButton { color: #b49cf8; }

/* Settings sidebar */
QListWidget#selectorList { background: transparent; border: none; outline: none; }
QListWidget#selectorList::item { padding: 10px 16px; border-radius: 10px; margin: 1px 0; }
QListWidget#selectorList::item:hover { background: #1d1930; }
QListWidget#selectorList::item:selected { background: #322a52; color: #ececf1; }

/* What's New and the update dialog */
QLabel#Ocarina2DialogTitle { font-size: 24px; font-weight: 600; color: #ececf1; }
QTextBrowser#Ocarina2Notes { background: transparent; border: none; font-size: 15px; }
QTextBrowser#Ocarina2Credits { background: transparent; border: none; font-size: 12px; }

/* Preparing shaders (ocarina2/precompile_gate.cpp) */
QDialog#Ocarina2Prepare { background: #0d0b16; }
QLabel#Ocarina2Lead { font-size: 16px; color: #cfc9e3; }
QProgressBar#Ocarina2PrepareBar { background: #1a162a; border: none; border-radius: 8px; }
QProgressBar#Ocarina2PrepareBar::chunk { background: #9a7cf5; border-radius: 8px; }
QLabel#Ocarina2StatusNote { color: #b49cf8; padding: 0 10px; }

/* In-game control strip (ocarina2/game_controls.cpp) */
QToolButton#Ocarina2StripButton { background: transparent; border: none; border-radius: 12px; }
QToolButton#Ocarina2StripButton:hover { background: #322a52; }
QToolButton#Ocarina2StripButton:pressed { background: #453a70; }

/* Home screen (ocarina2/home.cpp): the Switch 2 top bar, game tiles, dock and bottom strip */
QWidget#Ocarina2Dock { background: transparent; }
QToolButton#Ocarina2DockButton {
    background: #17161f;
    border: 1px solid #23212c;
    color: #cfccd9;
    border-radius: 26px;
    padding: 10px 10px;
    min-width: 86px;
}
QToolButton#Ocarina2DockButton:hover { background: #201f29; color: #ffffff; }
QToolButton#Ocarina2DockButton:pressed { background: #2a2836; }
QWidget#Ocarina2Home {
    background: qradialgradient(cx: 0.5, cy: 0.55, radius: 0.85,
        fx: 0.5, fy: 0.5,
        stop: 0 #141126,
        stop: 0.45 #100e20,
        stop: 1 #06060c);
}
QWidget#Ocarina2TopBar {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 rgba(255, 255, 255, 6), stop: 1 rgba(255, 255, 255, 0));
    border-bottom: 1px solid #1d1b28;
}
QToolButton#Ocarina2Avatar {
    background: #0a0a10;
    border: 2px solid rgba(245, 196, 69, 0.55);
    border-radius: 16px;
    min-width: 32px;
    min-height: 32px;
    max-width: 32px;
    max-height: 32px;
}
QToolButton#Ocarina2Avatar:hover { border-color: #ffd75e; background: #100f0c; }
QLabel#Ocarina2Wordmark {
    color: #c9c7da;
    background: transparent;
}
QWidget#Ocarina2Pills {
    background: #14131d;
    border: 1px solid #242230;
    border-radius: 999px;
}
QToolButton#Ocarina2Pill {
    background: transparent;
    border: 1px solid transparent;
    color: #9896ab;
    border-radius: 999px;
    padding: 6px 30px;
    font-size: 13px;
    font-weight: 600;
}
QToolButton#Ocarina2Pill:hover { color: #e8e6f2; }
QToolButton#Ocarina2Pill:checked {
    background: #39374a;
    color: #ffffff;
}
QLabel#Ocarina2Clock {
    color: #e6e4ee;
    font-size: 16px;
    font-weight: 700;
    background: transparent;
}
QLabel#Ocarina2TopIcon { color: #9896ab; background: transparent; }
QWidget#Ocarina2CurrentGameRow { background: transparent; }
QLabel#Ocarina2CurrentGame {
    color: #d4d2df;
    font-size: 14px;
    font-weight: 600;
    background: transparent;
}
QLabel#Ocarina2Section { font-size: 15px; color: #b7b2cd; }
QPushButton#Ocarina2Play {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #8b5cf6, stop: 0.5 #a78bfa, stop: 1 #c4b5fd);
    color: #ffffff;
    border: none;
    border-radius: 999px;
    min-height: 58px;
    max-height: 58px;
    min-width: 225px;
    padding: 0 40px;
    font-size: 20px;
    font-weight: 800;
}
QPushButton#Ocarina2Play:hover { background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #9b6df8, stop: 0.5 #b59efb, stop: 1 #cfc2fd); }
QPushButton#Ocarina2Play:pressed { background: #7c3aed; }
QToolButton#Ocarina2Tile {
    background: transparent;
    border: 3px solid transparent;
    border-radius: 20px;
    padding: 8px;
    color: #c9c6d8;
    font-size: 13px;
}
QToolButton#Ocarina2Tile:hover { background: #16161f; color: #ececf1; }
QWidget#Ocarina2BottomBar {
    border-top: 1px solid #201e2a;
    background: transparent;
}
QToolButton#Ocarina2ThemeButton {
    background: transparent;
    border: none;
    color: #8b8b9e;
    padding: 2px 8px;
    font-size: 12px;
}
QToolButton#Ocarina2ThemeButton:hover { color: #ffffff; }
QLabel#Ocarina2Hints { color: #6f6d80; background: transparent; }

/* Gamepad/keyboard focus rings (Switch 2 aqua) */
QToolButton#Ocarina2DockButton:focus {
    border: 2px solid #3fd8ff;
    background: #1d2026;
    color: #ffffff;
}
QToolButton#Ocarina2Tile:focus {
    background: rgba(63, 216, 255, 0.10);
    border: 3px solid #3fd8ff;
    color: #ffffff;
}
QPushButton#Ocarina2Play:focus {
    border: 3px solid #3fd8ff;
}
QToolButton#Ocarina2Pill:focus {
    border: 1px solid #3fd8ff;
}
QToolButton#Ocarina2Avatar:focus {
    border: 2px solid #3fd8ff;
}

/* Quick menu (ocarina2/quick_menu.cpp): the L3+R3 emulator pause screen */
QDialog#Ocarina2QuickMenu { background: rgba(7, 7, 13, 150); }
QWidget#Ocarina2QuickMenuPanel {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #191725, stop: 1 #131120);
    border: 1px solid #2b2940;
    border-radius: 22px;
}
QLabel#Ocarina2QuickMenuEyebrow { color: #3fd8ff; font-size: 11px; font-weight: 800; }
QLabel#Ocarina2QuickMenuTitle {
    color: #f2f0f7;
    font-size: 25px;
    font-weight: 800;
}
QPushButton#Ocarina2QuickMenuItem {
    background: transparent;
    border: 2px solid transparent;
    border-radius: 14px;
    color: #e6e3ef;
    font-size: 15px;
    padding: 11px 14px;
    text-align: left;
}
QPushButton#Ocarina2QuickMenuItem:hover { background: #201e2e; }
QPushButton#Ocarina2QuickMenuItem:pressed { background: #272436; }
QPushButton#Ocarina2QuickMenuItem:focus { border: 2px solid #3fd8ff; background: #1d2029; }
QPushButton#Ocarina2QuickMenuItem:disabled { color: #54525f; }
QPushButton#Ocarina2QuickMenuItemDanger {
    background: transparent;
    border: 2px solid transparent;
    border-radius: 14px;
    color: #ff8a80;
    font-size: 15px;
    padding: 11px 14px;
    text-align: left;
}
QPushButton#Ocarina2QuickMenuItemDanger:hover { background: #2a1e24; }
QPushButton#Ocarina2QuickMenuItemDanger:pressed { background: #33232b; }
QPushButton#Ocarina2QuickMenuItemDanger:focus { border: 2px solid #ff8a80; background: #221b20; }
QPushButton#Ocarina2QuickMenuItemDanger:disabled { color: #54525f; }
QPushButton#Ocarina2QuickMenuResume {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #8b5cf6, stop: 1 #a78bfa);
    border: 2px solid transparent;
    border-radius: 15px;
    color: #ffffff;
    font-size: 16px;
    font-weight: 800;
    padding: 12px;
}
QPushButton#Ocarina2QuickMenuResume:hover { background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
    stop: 0 #9b6df8, stop: 1 #b59efb); }
QPushButton#Ocarina2QuickMenuResume:focus { border: 2px solid #3fd8ff; }

/* Bubbly settings (ocarina2: configure dialog + per-game configure dialog) */
QDialog#ConfigureDialog, QDialog#ConfigurePerGame { background: #151320; }
QDialog#ConfigureDialog QLabel, QDialog#ConfigurePerGame QLabel { color: #d8d5e6; }
QDialog#ConfigureDialog QGroupBox, QDialog#ConfigurePerGame QGroupBox {
    border: 1px solid #2b2840;
    border-radius: 18px;
    margin-top: 14px;
    padding: 16px 14px 12px;
    background: rgba(255, 255, 255, 0.024);
}
QDialog#ConfigureDialog QGroupBox::title, QDialog#ConfigurePerGame QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    padding: 0 8px;
    color: #cfc9ea;
    font-weight: 700;
    font-size: 13px;
}
QDialog#ConfigureDialog QPushButton, QDialog#ConfigurePerGame QPushButton {
    background: #221f33;
    border: 1px solid #35324a;
    border-radius: 14px;
    padding: 9px 18px;
    font-size: 13px;
    color: #e6e3ef;
}
QDialog#ConfigureDialog QPushButton:hover, QDialog#ConfigurePerGame QPushButton:hover {
    background: #2a2740;
    border-color: #474260;
}
QDialog#ConfigureDialog QPushButton:pressed, QDialog#ConfigurePerGame QPushButton:pressed {
    background: #322f4e;
}
QDialog#ConfigureDialog QPushButton:focus, QDialog#ConfigurePerGame QPushButton:focus {
    border: 2px solid #9a7cf5;
    padding: 8px 17px;
}
QDialog#ConfigureDialog QPushButton:default, QDialog#ConfigurePerGame QPushButton:default {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #8b5cf6, stop: 1 #a78bfa);
    border: none;
    color: #ffffff;
    font-weight: 700;
}
QDialog#ConfigureDialog QPushButton:default:hover, QDialog#ConfigurePerGame QPushButton:default:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #9b6df8, stop: 1 #b59efb);
}
QDialog#ConfigureDialog QLineEdit, QDialog#ConfigureDialog QComboBox,
QDialog#ConfigureDialog QAbstractSpinBox, QDialog#ConfigureDialog QPlainTextEdit,
QDialog#ConfigureDialog QTextEdit,
QDialog#ConfigurePerGame QLineEdit, QDialog#ConfigurePerGame QComboBox,
QDialog#ConfigurePerGame QAbstractSpinBox, QDialog#ConfigurePerGame QPlainTextEdit,
QDialog#ConfigurePerGame QTextEdit {
    background: #1d1b2b;
    border: 1px solid #322f47;
    border-radius: 12px;
    padding: 8px 12px;
    font-size: 13px;
    color: #e6e3ef;
}
QDialog#ConfigureDialog QLineEdit:focus, QDialog#ConfigureDialog QComboBox:focus,
QDialog#ConfigureDialog QAbstractSpinBox:focus, QDialog#ConfigurePerGame QLineEdit:focus,
QDialog#ConfigurePerGame QComboBox:focus, QDialog#ConfigurePerGame QAbstractSpinBox:focus {
    border: 2px solid #9a7cf5;
    padding: 7px 11px;
}
QDialog#ConfigureDialog QCheckBox::indicator, QDialog#ConfigurePerGame QCheckBox::indicator {
    width: 19px;
    height: 19px;
    border-radius: 7px;
    border: 1px solid #4b4867;
    background: #1d1b2b;
}
QDialog#ConfigureDialog QCheckBox::indicator:checked, QDialog#ConfigurePerGame QCheckBox::indicator:checked {
    background: #9a7cf5;
    border-color: #a78bfa;
}
QDialog#ConfigureDialog QRadioButton::indicator, QDialog#ConfigurePerGame QRadioButton::indicator {
    width: 17px;
    height: 17px;
    border-radius: 9px;
    border: 1px solid #4b4867;
    background: #1d1b2b;
}
QDialog#ConfigureDialog QRadioButton::indicator:checked, QDialog#ConfigurePerGame QRadioButton::indicator:checked {
    background: #9a7cf5;
    border-color: #a78bfa;
}
QDialog#ConfigureDialog QListWidget#selectorList, QDialog#ConfigurePerGame QListWidget#selectorList {
    background: transparent;
    border: none;
    outline: none;
}
QDialog#ConfigureDialog QListWidget#selectorList::item, QDialog#ConfigurePerGame QListWidget#selectorList::item {
    padding: 13px 16px;
    border-radius: 14px;
    margin: 2px 0;
    font-size: 15px;
    color: #a5a2b6;
}
QDialog#ConfigureDialog QListWidget#selectorList::item:hover, QDialog#ConfigurePerGame QListWidget#selectorList::item:hover {
    background: #1e1c2b;
    color: #eceaf2;
}
QDialog#ConfigureDialog QListWidget#selectorList::item:selected, QDialog#ConfigurePerGame QListWidget#selectorList::item:selected {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #322a52, stop: 1 #2b2544);
    color: #ffffff;
    border: 1px solid #3d355a;
}
QDialog#ConfigureDialog QTabBar::tab, QDialog#ConfigurePerGame QTabBar::tab {
    padding: 8px 26px;
    margin: 2px;
    border-radius: 13px;
    background: transparent;
    color: #9896ab;
    border: none;
    font-size: 13px;
    font-weight: 600;
}
QDialog#ConfigureDialog QTabBar::tab:hover, QDialog#ConfigurePerGame QTabBar::tab:hover {
    background: #1e1c2b;
    color: #eceaf2;
}
QDialog#ConfigureDialog QTabBar::tab:selected, QDialog#ConfigurePerGame QTabBar::tab:selected {
    background: #322a52;
    color: #ffffff;
    border-bottom: none;
}
QDialog#ConfigureDialog QTabWidget::pane, QDialog#ConfigurePerGame QTabWidget::pane { border: none; }
QDialog#ConfigureDialog QScrollArea, QDialog#ConfigurePerGame QScrollArea { background: transparent; }
QDialog#ConfigureDialog QScrollArea > QWidget > QWidget, QDialog#ConfigurePerGame QScrollArea > QWidget > QWidget {
    background: transparent;
}
QDialog#ConfigureDialog QDialogButtonBox QPushButton, QDialog#ConfigurePerGame QDialogButtonBox QPushButton {
    min-width: 110px;
    padding: 10px 22px;
}
